# For more information, please see the README.md
SUNO_COOKIE=
TWOCAPTCHA_KEY= # Obtain from 2captcha.com
BROWSER=chromium # `chromium` or `firefox`, although `chromium` is highly recommended
BROWSER_GHOST_CURSOR=false
BROWSER_LOCALE=en
BROWSER_HEADLESS=true
# Interval between releasing queued requests after a CAPTCHA solve (ms)
# CAPTCHA_QUEUE_MIN_INTERVAL_MS=2000
# CAPTCHA_QUEUE_MAX_INTERVAL_MS=8000
# Public origin for MCP clients to fetch rewritten audio (HTTP routes use request origin)
# SUNO_PUBLIC_BASE_URL=http://10.243.220.176:8556