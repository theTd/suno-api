# For more information, please see the README.md
#
# Gotcha - a `$` fragment inside a value is interpolated and silently eats bytes:
# * docker compose expands variables in .env values (whether consumed through
#   `env_file:` or `build.args` - this repo now uses only `env_file:`), so `$foo`
#   becomes an empty string and every compose run warns
#   `The "foo" variable is not set`.
# * Next.js (@next/env + dotenv-expand) expands values too - including
#   single-quoted ones - so single quotes protect the compose path ONLY. Note
#   .env.local overrides .env in Next's load order.
# Keep `$` out of SUNO_COOKIE (e.g. drop the `_ga`/`_ga_*` Google Analytics cookies; Suno
# auth does not need them), or wrap the value in single quotes for the compose
# path. Values must use LF line endings: a quoted CRLF value keeps the CR and
# Node rejects it as an invalid Cookie header character.
# Re-quote idempotently after a cookie refresh:
#   grep -q "^SUNO_COOKIE='" .env || sed -i '/^SUNO_COOKIE=/s/^SUNO_COOKIE=/SUNO_COOKIE=\x27/; /^SUNO_COOKIE=/s/$/\x27/' .env
# Verify values survive compose injection before deploying:
#   bash scripts/check-env.sh
SUNO_COOKIE=
TWOCAPTCHA_KEY= # Obtain from 2captcha.com
BROWSER=chromium # `chromium` or `firefox`, although `chromium` is highly recommended
BROWSER_GHOST_CURSOR=false
BROWSER_LOCALE=en
# false = headed Chromium (Docker wraps this in Xvfb). true uses headless_shell and
# advertises HeadlessChrome in sec-ch-ua, which makes Suno require a CAPTCHA every time.
BROWSER_HEADLESS=false
# BROWSER_TIMEZONE=America/Los_Angeles
# Recycle the long-lived Chromium session after this age / this many captcha solves.
# BROWSER_SESSION_MAX_AGE_MS=7200000
# BROWSER_SESSION_MAX_SOLVES=20
# Interval between releasing queued requests after a CAPTCHA solve (ms)
# CAPTCHA_QUEUE_MIN_INTERVAL_MS=2000
# CAPTCHA_QUEUE_MAX_INTERVAL_MS=8000
# Public origin for MCP clients to fetch rewritten audio (HTTP routes use request origin)
# SUNO_PUBLIC_BASE_URL=http://10.243.220.176:8556
# Preview-to-MP3 transcoding for MCP audio embeds. Defaults to `ffmpeg` on PATH
# (Docker image ships it); override only when the binary lives elsewhere.
# PREVIEW_FFMPEG_PATH=/usr/bin/ffmpeg
# Preview captures reuse one persistent browser (new page per clip).
# Idle TTL before it is torn down (ms); back-to-back previews skip relaunch.
# PREVIEW_BROWSER_IDLE_MS=300000